# AI platform destinations not covered by ACL4SSR AI.list.
# Referenced from config/Home_Routing_v2.ini, placed before YouTube.list.

# Generic AI helpers.
DOMAIN-SUFFIX,challenges.cloudflare.com
DOMAIN-SUFFIX,sentry.io
DOMAIN-SUFFIX,stripe.com

# Google Antigravity: site, IDE/CLI hosts and the auto-updater on run.app.
DOMAIN-SUFFIX,antigravity.google
DOMAIN-KEYWORD,antigravity

# Google sign-in, so Antigravity auth exits through the same group as model calls.
DOMAIN-SUFFIX,accounts.google.com
DOMAIN-SUFFIX,oauth2.googleapis.com

# Google telemetry beacons (redundant with the suffix below, kept for clarity).
DOMAIN-SUFFIX,play.googleapis.com
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com
DOMAIN-SUFFIX,clearcut-pa.googleapis.com

# Broad Google API surface: model gateways (cloudcode-pa), Vertex-style APIs, etc.
DOMAIN-SUFFIX,googleapis.com
